{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:web",
  "outputDirectory": "web/dist",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/api/:path((?!carrier-accounts|carriers/|store-accounts|oauth/|debug-env|migrate-from|admin/).+)",
      "destination": "https://prepshipv4-api-l5xc.onrender.com/:path"
    },
    {
      "source": "/aws-api/:path*",
      "destination": "http://13.58.82.26:3000/:path*"
    },
    {
      "source": "/oauth/:path*",
      "destination": "/api/oauth/:path*"
    },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ]
}
