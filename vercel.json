{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:react",
  "outputDirectory": "apps/react/dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    }
  }
}
