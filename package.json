{
  "name": "prepshipv2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "tsx apps/api/src/main.ts",
    "dev:react": "npm run dev --workspace apps/react",
    "dev:web": "tsx apps/web/src/main.ts",
    "dev:worker": "tsx apps/worker/src/main.ts",
    "build:react": "npm run build --workspace apps/react",
    "db:migrate": "node scripts/migrate-postgres.mjs",
    "test": "tsx --test apps/api/test/*.test.ts apps/web/test/*.test.ts apps/react/test/*.test.ts"
  },
  "dependencies": {
    "express": "^5.2.1",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "tsx": "^4.21.0"
  }
}
