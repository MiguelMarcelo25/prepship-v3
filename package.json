{
  "name": "prepship-v4",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/main.ts",
    "dev:web": "vite",
    "start": "tsx src/main.ts",
    "start:api": "tsx src/main.ts",
    "start:worker": "tsx src/worker.ts",
    "build:web": "vite build",
    "preview:web": "vite preview",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "marketplace:reconcile": "tsx scripts/reconcile-marketplace-order-status.ts",
    "marketplace:reconcile:apply": "tsx scripts/reconcile-marketplace-order-status.ts --apply",
    "shipstation:awaiting:diff": "tsx scripts/reconcile-shipstation-awaiting.ts --diff",
    "shipstation:awaiting:reconcile": "tsx scripts/reconcile-shipstation-awaiting.ts",
    "shipstation:awaiting:reconcile:apply": "tsx scripts/reconcile-shipstation-awaiting.ts --apply",
    "inventory:reconcile:dry-run": "tsx scripts/reconcile-inventory-stock.ts",
    "best-rate:dims:dry-run": "tsx scripts/clear-invalid-best-rates.ts",
    "best-rate:dims:apply": "tsx scripts/clear-invalid-best-rates.ts --apply",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "test:client-redaction": "node scripts/client-redaction-guard.mjs",
    "test:credential-accounts": "node scripts/credential-accounts-guard.mjs",
    "test:rate-system-hardening": "node scripts/rate-system-hardening-guard.mjs",
    "test:best-rate-dims": "node scripts/best-rate-dims-guard.mjs",
    "test:runtime-ddl": "node scripts/runtime-ddl-guard.mjs",
    "test:vercel-function-imports": "node scripts/vercel-function-imports-guard.mjs",
    "test:auth-coverage": "node scripts/auth-coverage-guard.mjs",
    "test:rbac-permissions": "node scripts/rbac-permissions-guard.mjs",
    "test:client-store-scope": "node scripts/client-store-scope-guard.mjs",
    "test:dashboard-client-scope": "node scripts/dashboard-client-store-scope-guard.mjs",
    "test:dashboard-orders-units": "node scripts/dashboard-orders-units-guard.mjs",
    "test:analysis-client-scope": "node scripts/analysis-client-store-scope-guard.mjs",
    "test:inventory-client-scope": "node scripts/inventory-client-store-scope-guard.mjs",
    "test:inventory-default-view": "node scripts/inventory-default-view-guard.mjs",
    "test:inventory-source-of-truth": "node scripts/inventory-source-of-truth-guard.mjs",
    "test:inventory-reconciliation-dry-run": "node scripts/inventory-reconciliation-dry-run-guard.mjs",
    "test:inventory-repair-plan": "node scripts/inventory-repair-plan-guard.mjs",
    "test:billing-client-scope": "node scripts/billing-client-store-scope-guard.mjs",
    "test:print-queue-client-scope": "node scripts/print-queue-client-store-scope-guard.mjs",
    "test:orders-manifests-scope": "node scripts/orders-manifests-client-store-scope-guard.mjs",
    "test:field-level-rbac": "node scripts/field-level-rbac-guard.mjs",
    "test:field-level-rbac-extended": "node scripts/field-level-rbac-extended-guard.mjs",
    "test:label-shipment-scope-review": "node scripts/label-shipment-scope-review-guard.mjs",
    "test:print-queue-ownership": "node scripts/print-queue-ownership-guard.mjs",
    "test:secrets-governance": "node scripts/secrets-governance-guard.mjs",
    "test:audit-logging": "node scripts/audit-logging-guard.mjs",
    "test:reconciliation-plan": "node scripts/reconciliation-plan-guard.mjs",
    "test:observability-alerting": "node scripts/observability-alerting-guard.mjs",
    "test:operational-runbooks": "node scripts/operational-runbooks-guard.mjs",
    "test:privacy-compliance": "node scripts/privacy-compliance-guard.mjs",
    "test:production-signoff": "node scripts/production-signoff-guard.mjs",
    "test:durable-jobs-plan": "node scripts/durable-jobs-plan-guard.mjs",
    "test:rate-backfill-durable": "node scripts/rate-backfill-durable-guard.mjs",
    "test:ref-rates-durable": "node scripts/ref-rates-durable-guard.mjs",
    "test:print-queue-durable": "node scripts/print-queue-durable-guard.mjs",
    "test:marketplace-reconciliation": "tsx scripts/marketplace-status-reconciliation-guard.ts",
    "test:shipstation-awaiting-parity": "tsx scripts/shipstation-awaiting-parity-guard.ts",
    "test:jwt-session-policy": "node scripts/jwt-session-policy-guard.mjs",
    "test:auth-logout": "node scripts/auth-logout-guard.mjs",
    "test:frontend-failure-states": "node scripts/frontend-failure-states-guard.mjs",
    "test:orders-ux": "node scripts/orders-ux-guard.mjs",
    "test:orders-ux:browser": "playwright test web/e2e/orders-ux.spec.js --reporter=line",
    "test:inventory-ux:browser": "playwright test web/e2e/inventory-ux.spec.js --reporter=line"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@hono/zod-validator": "^0.4.2",
    "@supabase/supabase-js": "^2.47.10",
    "@tanstack/react-query": "^5.62.7",
    "cobe": "^2.0.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.36.4",
    "framer-motion": "^12.38.0",
    "hono": "^4.6.14",
    "jose": "^5.9.6",
    "jszip": "^3.10.1",
    "lucide-react": "^0.469.0",
    "pdf-lib": "^1.17.1",
    "pg-boss": "^10.1.5",
    "postgres": "^3.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.6.0",
    "react-router-dom": "^7.0.2",
    "recharts": "^2.15.1",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "drizzle-kit": "^0.28.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "ts-morph": "^28.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
