# Supabase project settings
# Dashboard: https://supabase.com/dashboard/project/<ref>/settings/api
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_JWT_SECRET=your-jwt-secret-from-api-settings

# Database connection (use the Supabase Transaction Pooler — port 6543)
# Settings -> Database -> Connection string -> Transaction
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres

# App
PORT=3000
NODE_ENV=development

# Comma-separated list of allowed frontend origins.
# In development, localhost/private LAN origins are allowed automatically.
# Example: https://prepship.vercel.app,https://prepship-v4-stable.vercel.app
WEB_ORIGIN=

# Shared secret for the /cron/* endpoints (no Supabase auth on those).
# External cron pinger (cron-job.org, GitHub Actions, etc.) must send
# this value in the X-Cron-Secret header. Leave unset to disable /cron/*.
CRON_SECRET=

# Database pool safety. Keep these conservative because API and Worker share
# the same Supabase pooler. Higher values can make page loads wait behind sync.
DB_HEALTH_TIMEOUT_MS=12000
DB_POOL_MAX=4
DB_IDLE_TIMEOUT_SECONDS=10
DB_CONNECT_TIMEOUT_SECONDS=8
DB_STATEMENT_TIMEOUT_MS=12000

# Optional: background best-rate backfill is heavy. Keep it off unless you
# explicitly want the API process to estimate rates in the background.
ENABLE_RATE_BACKFILL_SCHEDULER=false

# Audit 5.2 optional advisory tariff calibration. OFF means zero probe calls.
# When enabled on the worker, one bounded nightly job reads live rates and
# refreshes a non-purchasable model in analytics_cache.
ENABLE_LOCAL_TARIFF_CALIBRATION_SCHEDULER=false
LOCAL_TARIFF_CALIBRATION_DESTINATIONS=94105,80202,60601,10001
LOCAL_TARIFF_CALIBRATION_WEIGHTS_OZ=16,32,80
LOCAL_TARIFF_CALIBRATION_MAX_PROBES=20

# Runtime split controls.
# Legacy/default behavior keeps the API scheduler running until production envs
# are flipped. Final setup:
#   Render API: RUN_SYNC_SCHEDULER=false
#   Render Worker: RUN_SYNC_SCHEDULER=true, WORKER_PLACEHOLDER=false
RUN_SYNC_SCHEDULER=true
WORKER_PLACEHOLDER=false
WORKER_UNCAUGHT_FAILURE_LIMIT=3
RUN_ORDERS_PERFORMANCE_MAINTENANCE=
PG_BOSS_SCHEMA=pgboss
PG_BOSS_POOL_MAX=1
# PS-430: required on the production Print Queue worker. Use Supabase direct
# (db.<ref>.supabase.co:5432) or session mode (*.pooler.supabase.com:5432),
# never the transaction pooler on port 6543. Do not use this URL for ordinary
# API SQL. The API continues using DATABASE_URL above.
PRINT_QUEUE_PG_BOSS_DATABASE_URL=
PRINT_QUEUE_PG_BOSS_STATEMENT_TIMEOUT_MS=12000
PRINT_QUEUE_PG_BOSS_IDLE_IN_TRANSACTION_TIMEOUT_MS=15000
PRINT_QUEUE_WORKER_HEALTH_INTERVAL_MS=30000

# PS-431 shipment-sync watchdog escalation. Configure the same phone-reachable
# webhook in Render and GitHub. Alert timestamps are persisted by state so the
# same state cannot page more than once per 30 minutes.
SHIPMENT_SYNC_WATCHDOG_ALERT_WEBHOOK_URL=
SHIPMENT_SYNC_WATCHDOG_ALERT_COOLDOWN_MS=1800000
SHIPMENT_SYNC_WATCHDOG_ALERT_TIMEOUT_MS=10000
SHIPMENT_SYNC_WATCHDOG_ALLOW_RESTARTS=false

# Frontend (Vite reads these — must start with VITE_)
VITE_API_URL=http://localhost:3000
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# ShipStation (carrier gateway)
SHIPSTATION_API_KEY=
SHIPSTATION_API_SECRET=
SHIPSTATION_API_KEY_V2=
SHIPSTATION_BATCHED_RATE_FANOUT=false

# Default ship-from address (required for live rate/label calls)
SHIP_FROM_NAME=
SHIP_FROM_COMPANY=
SHIP_FROM_STREET1=
SHIP_FROM_STREET2=
SHIP_FROM_CITY=
SHIP_FROM_STATE=
SHIP_FROM_POSTAL_CODE=
SHIP_FROM_COUNTRY=US
SHIP_FROM_PHONE=
