# Supabase project settings
# Dashboard: https://supabase.com/dashboard/project/<ref>/settings/api
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_JWT_SECRET=your-jwt-secret-from-api-settings

# Database connection (use the Supabase Transaction Pooler — port 6543)
# Settings -> Database -> Connection string -> Transaction
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres

# App
PORT=3000
NODE_ENV=development

# ShipStation (carrier gateway)
SHIPSTATION_API_KEY=
SHIPSTATION_API_SECRET=
SHIPSTATION_API_KEY_V2=
