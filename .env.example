# Supabase project settings
# Dashboard: https://supabase.com/dashboard/project/<ref>/settings/api
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_JWT_SECRET=your-jwt-secret-from-api-settings

# Database connection (use the Supabase Transaction Pooler — port 6543)
# Settings -> Database -> Connection string -> Transaction
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres

# App
PORT=3000
NODE_ENV=development

# Comma-separated list of allowed frontend origins.
# In development, localhost/private LAN origins are allowed automatically.
# Example: https://prepship.vercel.app,https://prepship-v4-stable.vercel.app
WEB_ORIGIN=

# Shared secret for the /cron/* endpoints (no Supabase auth on those).
# External cron pinger (cron-job.org, GitHub Actions, etc.) must send
# this value in the X-Cron-Secret header. Leave unset to disable /cron/*.
CRON_SECRET=

# Database pool safety. Keep these conservative because API and Worker share
# the same Supabase pooler. Higher values can make page loads wait behind sync.
DB_HEALTH_TIMEOUT_MS=12000
DB_POOL_MAX=4
DB_IDLE_TIMEOUT_SECONDS=10
DB_CONNECT_TIMEOUT_SECONDS=8
DB_STATEMENT_TIMEOUT_MS=12000

# Optional: background best-rate backfill is heavy. Keep it off unless you
# explicitly want the API process to estimate rates in the background.
ENABLE_RATE_BACKFILL_SCHEDULER=false

# Runtime split controls.
# Legacy/default behavior keeps the API scheduler running until production envs
# are flipped. Final setup:
#   Render API: RUN_SYNC_SCHEDULER=false
#   Render Worker: RUN_SYNC_SCHEDULER=true, WORKER_PLACEHOLDER=false
RUN_SYNC_SCHEDULER=true
WORKER_PLACEHOLDER=false
RUN_ORDERS_PERFORMANCE_MAINTENANCE=
USE_PG_BOSS_SCHEDULER=true
PG_BOSS_SCHEMA=pgboss
PG_BOSS_POOL_MAX=1

# Frontend (Vite reads these — must start with VITE_)
VITE_API_URL=http://localhost:3000
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# ShipStation (carrier gateway)
SHIPSTATION_API_KEY=
SHIPSTATION_API_SECRET=
SHIPSTATION_API_KEY_V2=
SHIPSTATION_BATCHED_RATE_FANOUT=false

# Default ship-from address (required for live rate/label calls)
SHIP_FROM_NAME=
SHIP_FROM_COMPANY=
SHIP_FROM_STREET1=
SHIP_FROM_STREET2=
SHIP_FROM_CITY=
SHIP_FROM_STATE=
SHIP_FROM_POSTAL_CODE=
SHIP_FROM_COUNTRY=US
SHIP_FROM_PHONE=
