{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prepship.local/schemas/final-review-evidence-packet-v1.json",
  "title": "PrepShip Final Review evidence packet",
  "description": "Machine-readable, exact-SHA closure proof for risk-aware Final Review.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "taskId",
    "title",
    "target",
    "riskDomains",
    "claimedScore",
    "acceptanceCriteria",
    "architecture",
    "evidence",
    "migrations",
    "rollback",
    "liveVerification",
    "caveats"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": 1 },
    "taskId": { "type": "string", "pattern": "^(PS|CP)-[0-9]+$" },
    "title": { "$ref": "#/$defs/nonEmptyString" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch", "reviewedSha"],
      "properties": {
        "branch": { "$ref": "#/$defs/nonEmptyString" },
        "reviewedSha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" }
      }
    },
    "riskDomains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "auth_scope",
          "rate_label",
          "provider_durable_job",
          "billing_inventory_lifecycle",
          "timing_live",
          "governance"
        ]
      }
    },
    "claimedScore": { "type": "integer", "minimum": 0, "maximum": 100 },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/criterion" }
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalOwners", "oldOwners", "wrappers", "sotBypass"],
      "properties": {
        "canonicalOwners": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "oldOwners": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "disposition", "delegatesTo"],
            "properties": {
              "path": { "$ref": "#/$defs/nonEmptyString" },
              "disposition": {
                "enum": ["deleted", "delegated", "retained-with-caveat", "none"]
              },
              "delegatesTo": { "$ref": "#/$defs/nullableNonEmptyString" }
            }
          }
        },
        "wrappers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "action", "delegatesTo"],
            "properties": {
              "path": { "$ref": "#/$defs/nonEmptyString" },
              "action": {
                "enum": ["added", "modified", "deleted", "forbidden", "none"]
              },
              "delegatesTo": { "$ref": "#/$defs/nullableNonEmptyString" }
            }
          }
        },
        "sotBypass": {
          "type": "object",
          "additionalProperties": false,
          "required": ["present", "details"],
          "properties": {
            "present": { "type": "boolean" },
            "details": { "$ref": "#/$defs/nonEmptyString" }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidence" }
    },
    "migrations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["touched", "paths", "verification", "rollbackPlan"],
      "properties": {
        "touched": { "type": "boolean" },
        "paths": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["command", "result", "artifactPaths"],
          "properties": {
            "command": { "$ref": "#/$defs/nonEmptyString" },
            "result": { "$ref": "#/$defs/result" },
            "artifactPaths": {
              "type": "array",
              "items": { "$ref": "#/$defs/nonEmptyString" }
            }
          }
        },
        "rollbackPlan": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "tested", "evidenceIds"],
      "properties": {
        "strategy": { "$ref": "#/$defs/nonEmptyString" },
        "tested": { "type": "boolean" },
        "evidenceIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "liveVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason", "followUpOwner", "artifactPaths"],
      "properties": {
        "status": { "enum": ["verified", "unverified", "not-required"] },
        "reason": { "$ref": "#/$defs/nonEmptyString" },
        "followUpOwner": { "$ref": "#/$defs/nullableNonEmptyString" },
        "artifactPaths": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "caveats": {
      "type": "array",
      "items": { "$ref": "#/$defs/caveat" }
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "nullableNonEmptyString": {
      "anyOf": [
        { "$ref": "#/$defs/nonEmptyString" },
        { "type": "null" }
      ]
    },
    "result": {
      "enum": ["pass", "fail", "blocked", "not-run", "not-applicable"]
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity", "status", "description", "evidenceIds"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "severity": { "enum": ["critical", "high", "medium", "low"] },
        "status": { "enum": ["met", "unmet", "blocked"] },
        "description": { "$ref": "#/$defs/nonEmptyString" },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "classification",
        "command",
        "result",
        "artifactPaths",
        "assertions",
        "proves"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "classification": {
          "enum": [
            "static",
            "unit",
            "integration",
            "adversarial",
            "failure-injection",
            "e2e",
            "live"
          ]
        },
        "command": { "$ref": "#/$defs/nonEmptyString" },
        "result": { "$ref": "#/$defs/result" },
        "artifactPaths": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "assertions": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "proves": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "caveat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "severity",
        "status",
        "description",
        "followUpOwner",
        "followUpTask"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "severity": { "enum": ["critical", "high", "medium", "low"] },
        "status": { "enum": ["open", "closed"] },
        "description": { "$ref": "#/$defs/nonEmptyString" },
        "followUpOwner": { "$ref": "#/$defs/nullableNonEmptyString" },
        "followUpTask": { "$ref": "#/$defs/nullableNonEmptyString" }
      }
    }
  }
}
