{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@prepship/*": ["packages/*/src"]
    }
  },
  "include": ["api/**/*.ts", "apps/**/*.ts", "packages/**/*.ts"]
}
